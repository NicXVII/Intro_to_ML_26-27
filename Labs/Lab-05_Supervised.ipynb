    "import numpy as np\n",
    "\n",
    "class ID3DecisionTree:\n",
    "    \"\"\"\n",
    "    The tree is a nested dictionary: {feature: {value: subtree_or_label}}\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self):\n",
